<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
    This XML template extends the "LoginEmployeeDetails" view by adding a button labeled "Company Policy" inside
    the "contact" div element. When clicked, this button triggers the "getCompanyPolicy" function.
    -->
    <t t-inherit="LoginEmployeeDetails" t-inherit-mode="extension">
        <!--
        Match on the class token rather than the whole attribute: the target
        div in hrms_dashboard carries "contact p-3 border-bottom", so an exact
        @class='contact' test finds nothing and OWL aborts the whole dashboard
        with "cannot be located in element tree". hasclass() is a server-side
        lxml extension and is not available here, since OWL resolves template
        inheritance with the browser's XPath 1.0 engine.
        -->
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' contact ')]" position="inside">
            <div class="company-container">
                <button type="button" t-on-click="getCompanyPolicy" class="btn btn-third oe_company_policy"
                        id="company_policy">
                    Company Policy
                </button>
            </div>
        </xpath>
    </t>
</templates>
